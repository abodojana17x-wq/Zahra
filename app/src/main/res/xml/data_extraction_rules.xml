<?xml version="1.0" encoding="utf-8"?><!--
   زهرة — المرحلة 6 / D34: منع النسخ الاحتياطي السحابي والنقل بين الأجهزة.

   allowBackup="false" يمنع النسخ الاحتياطي على API ≤30، لكن على Android 12+
   فإن غياب قسم <device-transfer> يعني تفعيل نقل كل المحتوى افتراضيًا. لذلك
   نستثني كل النطاقات صراحةً في القسمين (بما فيها device_*).

   لم يُختبر هذا السلوك على جهاز/OEM بعد. راجع docs/PRIVACY.md وdocs/LIMITATIONS.md.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
    <!-- النقل عبر المنصات (iOS) يُعد وضعًا ثالثًا؛ غيابه يعني تفعيله افتراضيًا. -->
    <cross-platform-transfer platform="ios">
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cross-platform-transfer>
</data-extraction-rules>
